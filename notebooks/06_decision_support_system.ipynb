     "output_type": "stream",
     "text": [
      "'Which tablets help me study longer?'         -> topic: medical\n",
      "'Who won the cricket match yesterday?'        -> topic: unrelated\n",
      "'What should I do first?'                     -> topic: in_scope\n",
      "\n",
      "Engineering at University of Peradeniya: the 2023/2024 cut-off for Gampaha district was 1.9259. Your predicted Z-score (1.42) is 0.51 below it, so it is further away for now: your whole likely range is below last year's cut-off. This is a guide from last year's cut-offs, not a promise: cut-offs change every year, and the UGC also uses the order in which you list universities.\n"
     ]
    }
   ],
   "source": [
    "from src.chatbot.guard import topic_of\n",
    "from src.chatbot.lookup import university_answer\n",
    "for message in (\"Which tablets help me study longer?\", \"Who won the cricket match yesterday?\", \"What should I do first?\"):\n",
    "    print(f\"{message!r:45} -> topic: {topic_of(message)}\")\n",
    "print()\n",
    "print(university_answer(\"Am I close to University of Peradeniya?\", reports[\"average\"]))"
   ]
  }
